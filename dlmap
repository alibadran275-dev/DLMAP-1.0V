class ReportGenerator:
    def __init__(self, target: str, results: dict, summary: dict, duration: float):
        self.target = target
        self.results = results
        self.summary = summary
        self.duration = duration
        self.timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
    def generate_nmap_cli_report(self) -> str:
        lines = []
        lines.append(f"Starting {PROJECT_NAME} {VERSION} ( {WEBSITE} ) at {self.timestamp} +0300")
        lines.append(f"DLMap scan report for {self.target}")
        lines.append(f"Target system is fully reachable ({self.duration:.3f}s latency).")
        
        total_files = len(self.results)
        vulnerable_files_count = 0
        vulnerable_results = []
        
        for filepath, data in self.results.items():
            if "error" in data:
                continue
            findings = data.get("findings", [])
            if findings or data.get("permissions") or data.get("exported_components"):
                vulnerable_files_count += 1
                vulnerable_results.append((filepath, data))
                
        safe_files_count = total_files - vulnerable_files_count
        lines.append(f"Not shown: {safe_files_count} completely secure assets (no vulnerabilities flagged)")
        
        # PORT STATE SERVICE VERSION header
        lines.append(f"{'PORT/FILE':<30} {'STATE':<10} {'SERVICE':<20} {'VERSION / AUDIT TARGET'}")
        lines.append("="*80)
        
        for filepath, data in vulnerable_results:
            findings = data.get("findings", [])
            perms = data.get("permissions", [])
            comps = data.get("exported_components", [])
            
            if filepath == "AndroidManifest.xml":
                service = "AndroidManifest"
                version_info = f"Android Config ({len(findings) + len(perms) + len(comps)} findings)"
            elif filepath.endswith(('.py', '.java', '.kt', '.swift', '.js', '.ts')):
                service = "SourceCode"
                version_info = f"Code Logic ({len(findings)} findings)"
            else:
                service = "ConfigFile"
                version_info = f"Static Asset ({len(findings)} findings)"
                
            lines.append(f"{filepath:<30} {'open':<10} {service:<20} {version_info}")
            
            # Format findings like Nmap NSE script output
            idx = 1
            all_items = []
            for p in perms:
                all_items.append({
                    "id": "M004_PERM",
                    "risk": "HIGH",
                    "title": f"Dangerous Permission: {p['name']}",
                    "line": p["line"],
                    "evidence": p["desc"],
                    "remediation": "Review and remove permission if unnecessary."
                })
            for c in comps:
                all_items.append({
                    "id": "M005_EXPORT",
                    "risk": c["risk"],
                    "title": f"Unprotected Exported {c['type'].capitalize()}: {c['name']}",
                    "line": c["line"],
                    "evidence": "Lacks android:permission attribute",
                    "remediation": "Declare a private permission or set android:exported='false'"
                })
            for f in findings:
                all_items.append({
                    "id": f["rule_id"],
                    "risk": f["risk"],
                    "title": f["title"],
                    "line": f["line"],
                    "evidence": f["evidence"],
                    "remediation": f["remediation"],
                    "masvs": f.get("masvs", ""),
                    "cwe": f.get("cwe", "")
                })
                
            seen_dedup = set()
            for idx, item in enumerate(all_items, 1):
                clean_title = re.sub(r'\s*-\s*Signature Class\s+\d+', '', item["title"])
                dedup_key = (clean_title, item["line"])
                if dedup_key in seen_dedup:
                    continue
                seen_dedup.add(dedup_key)
                
                is_last = (idx == len(all_items))
                branch = "|_" if is_last else "| "
                
                risk_lvl = item["risk"]
                color = RISK_COLORS.get(risk_lvl, "")
                
                cwe_str = f" | CWE-{item['cwe'].split('-')[-1] if '-' in item['cwe'] else item['cwe']}" if item.get('cwe') else ""
                lines.append(f"{branch}{item['id']}: [{color}{risk_lvl}{RESET_COLOR}] Line {item['line']}: {clean_title}{cwe_str}")
                if item.get("evidence") and item["evidence"] != "XML Attribute Match" and item["evidence"] != "Structural XML Match":
                    lines.append(f"|   - Code Evidence: {item['evidence']}")
                lines.append(f"|_  - Remediation Action: {item['remediation']}")
                
            lines.append("") # Spacer
            
        lines.append("="*80)
        lines.append("DLMAP SECURITY COMPLIANCE REPORT SUMMARY")
        lines.append("="*80)
        for risk in RISK_HIERARCHY:
            count = self.summary['risk_breakdown'].get(risk, 0)
            lines.append(f" - {risk:<12}: {count} vulnerability(ies) discovered.")
        lines.append("")
        
        lines.append(f"DLMap done: {total_files} file(s) analyzed ({vulnerable_files_count} vulnerable target(s) found) in {self.duration:.4f} seconds")
        return "\n".join(lines)

