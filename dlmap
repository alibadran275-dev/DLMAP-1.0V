    print("File Size: 0.00 MB")
    print("\n| DLMap-NSE Scripts:")

    # 1. Static Analysis (Entropy)
    entropy = calculate_file_entropy(target_file)
    print("|_  static-analysis (COMPRESSION/NATIVE):")
