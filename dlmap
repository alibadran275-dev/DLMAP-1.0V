# HIGH-PERFORMANCE COORDINATOR (THREADED SCANNER)
# ========================================================================================
class ProjectScanner:
    def __init__(self, target_path: str, threads: int = 8):
        self.target_path = target_path
        self.threads = threads
        self.results = {}
        self.total_files_scanned = 0
        self.total_findings = 0
        
    def find_target_files(self) -> list:
        targets = []
        if os.path.isfile(self.target_path):
            return [self.target_path]
        for root, dirs, files in os.walk(self.target_path):
            dirs[:] = [d for d in dirs if d not in SCAN_CONFIG["ignored_directories"]]
            for file in files:
                _, ext = os.path.splitext(file)
                if ext.lower() in SCAN_CONFIG["supported_extensions"] or file == "AndroidManifest.xml":
                    targets.append(os.path.join(root, file))
        return targets

    def scan(self) -> tuple:
        start_time = time.time()
        targets = self.find_target_files()
        
        with ThreadPoolExecutor(max_workers=self.threads) as executor:
            futures = {executor.submit(CompactAuditor(fp).audit): fp for fp in targets}
            for fut in as_completed(futures):
                fp = futures[fut]
                rel_path = os.path.relpath(fp, self.target_path) if os.path.isdir(self.target_path) else os.path.basename(fp)
                try:
                    res = fut.result()
                    if "error" not in res:
                        self.results[rel_path] = res
                        self.total_files_scanned += 1
                        self.total_findings += len(res.get("findings", [])) + len(res.get("permissions", [])) + len(res.get("exported_components", []))
                except Exception as e:
                    self.results[rel_path] = {"error": f"Scanner failed: {e}"}
                    
        duration = time.time() - start_time
        return self.results, duration

    def get_summary(self) -> dict:
        risk_counts = {risk: 0 for risk in RISK_HIERARCHY}
        for result in self.results.values():
            for f in result.get("findings", []):
                risk_counts[f["risk"]] += 1
            for p in result.get("permissions", []):
                risk_counts["HIGH"] += 1
            for c in result.get("exported_components", []):
                risk_counts[c["risk"]] += 1
        return {
            "total_files_scanned": self.total_files_scanned,
            "total_findings": self.total_findings,
            "risk_breakdown": risk_counts
        }

