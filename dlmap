# --- Function to calculate file entropy (remains the same) ---
def calculate_file_entropy(filepath):
    """Calculates Shannon Entropy of a file."""
    if not os.path.exists(filepath):
        return 0.0

    with open(filepath, 'rb') as f:
        data = f.read()

    if not data:
        return 0.0

    byte_counts = {}
    for byte in data:
        byte_counts[byte] = byte_counts.get(byte, 0) + 1

    file_size = len(data)
    entropy = 0.0

    for count in byte_counts.values():
        probability = count / file_size
        entropy -= probability * math.log2(probability)

    return entropy

# --- Unified Report Printing Function ---
def print_report_section(title, script_name, results, mock_info=None):
    """Prints a standardized report section using unified results format."""
    print(f"|_  {script_name} ({title}):")
    
    all_items = results
    if mock_info:
        all_items.extend(mock_info)

    if not all_items:
        print("|     [INFO]: No issues detected.")
        return

    # Handle results from the core scanner
    for item in all_items:
        tag = f"[{item['risk']}]" if 'risk' in item else ""
        
        output_line = item.get('type', 'Unknown Issue')
        
        # Determine the output line content based on available keys
        if item.get('value'):
             # Secrets/Crypto (masked values)
             output_line = f"{item.get('type', '')} Found: \"{item['value']}\""
        elif item.get('scheme'):
             # Deeplinks
             output_line = f"{item.get('type', '')} - {item['scheme']}"
        elif item.get('type') and item.get('risk') in ['HIGH', 'MEDIUM', 'INFO']:
             # Integrity, Manifest, Components, Permissions
             pass 
        
        details_line = item.get('details')
        
        print(f"|     {tag}: {output_line}")
        if details_line:
             print(f"|       - Risk: {details_line}")
    
    print("|")


# --- Main DLMap Execution Logic (FINAL CLEANED VERSION) ---
