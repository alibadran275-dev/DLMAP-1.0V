class CompactAuditor:
    def __init__(self, filepath):
        self.filepath = filepath
        self.filename = os.path.basename(filepath)
        
    def audit(self):
        try:
            with open(self.filepath, 'rb') as f:
                raw_bytes = f.read()
        except IOError:
            return {"error": "IO Error"}
            
        file_size = len(raw_bytes)
        file_entropy = EntropyCalculator.calculate_shannon_entropy(raw_bytes)
        is_binary = any(self.filename.endswith(ext) for ext in ['.dex', '.class', '.so', '.dll', '.exe', '.jar', '.apk', '.aar'])
        
        if is_binary:
            content = "\n".join(StringExtractor.extract_strings(raw_bytes))
        else:
            content = raw_bytes.decode('utf-8', errors='ignore')
            
        lines = content.splitlines()
        findings = []
        permissions_found = []
        exported_components = []
        
        # Run Taint dataflow on python files
        if self.filename.endswith('.py'):
            try:
                tree = ast.parse(content)
                visitor = TaintVisitor()
                visitor.visit(tree)
                findings.extend(visitor.violations)
            except SyntaxError:
                pass

        if self.filename == 'AndroidManifest.xml':
            self.audit_manifest(content, lines, findings, permissions_found, exported_components)
        else:
            self.audit_source_code(content, lines, findings)
            
        return {
            "entropy": file_entropy,
            "findings": findings,
            "permissions": permissions_found,
            "exported_components": exported_components,
            "size": file_size,
            "is_binary": is_binary
        }
        
    def audit_manifest(self, content, lines, findings, permissions, exported):
        try:
            xml_data = re.sub(r'\sxmlns:android="[^"]+"', '', content)
            xml_data = re.sub(r'\bandroid:', '', xml_data)
            root = ET.fromstring(xml_data)
        except Exception:
            return
            
        for perm in root.findall('uses-permission'):
            name = perm.get('name')
            if name in DANGEROUS_PERMISSIONS:
                permissions.append({
                    "name": name,
                    "desc": DANGEROUS_PERMISSIONS[name],
                    "line": 1
                })
                
        app = root.find('application')
        if app is not None:
            if app.get('debuggable') == 'true':
                findings.append(self.build_finding("M001_DEBUG_MODE"))
            if app.get('allowBackup') == 'true':
                findings.append(self.build_finding("M002_BACKUP_ENABLED"))
            if app.get('usesCleartextTraffic') == 'true':
                findings.append(self.build_finding("M003_CLEARTEXT_TRAFFIC"))
                
            for comp_tag in ['activity', 'service', 'receiver', 'provider']:
                for comp in app.findall(comp_tag):
                    name = comp.get('name', 'Unspecified')
                    is_exp = comp.get('exported') == 'true' or (comp.get('exported') is None and comp.find('intent-filter') is not None)
                    if is_exp and not comp.get('permission'):
                        exported.append({
                            "type": comp_tag,
                            "name": name,
                            "risk": "HIGH" if comp_tag in ['activity', 'provider'] else "MEDIUM",
                            "line": 1
                        })
                        
    def audit_source_code(self, content, lines, findings):
        for rule in VULNERABILITY_RULES["code"]:
            for match in re.finditer(rule["pattern"], content, re.IGNORECASE):
                line = content[:match.start()].count('\n') + 1
                risk, esc, de_esc = ContextAnalyzer.evaluate_context(lines, line, rule["risk"])
                
                matched_text = match.group(0)
                if len(matched_text) > 12 and any(kw in rule["id"] for kw in ["KEY", "TOKEN", "SECRET"]):
                    masked = DataMasker.mask_secret(matched_text)
                else:
                    masked = matched_text
                    
                findings.append({
                    "rule_id": rule["id"],
                    "risk": risk,
                    "title": rule["title"],
                    "line": line,
                    "evidence": DataMasker.mask_evidence(masked),
                    "description": rule["description"],
                    "impact": rule["impact"],
                    "remediation": rule["remediation"],
                    "masvs": rule["masvs"],
                    "cwe": rule["cwe"],
                    "cvss_score": rule["cvss_score"]
                })
                
    def build_finding(self, rule_id):
        for r in VULNERABILITY_RULES["manifest"]:
            if r["id"] == rule_id:
                return {
                    "rule_id": r["id"],
                    "risk": r["risk"],
                    "title": r["title"],
                    "line": 1,
                    "evidence": "Structural XML Match",
                    "description": r["description"],
                    "impact": r["impact"],
                    "remediation": r["remediation"],
                    "masvs": r["masvs"],
                    "cwe": r["cwe"],
                    "cvss_score": r["cvss_score"]
                }
        return {"rule_id": rule_id, "risk": "MEDIUM", "title": rule_id, "line": 1, "evidence": "Match", "masvs": "", "cwe": "", "cvss_score": 5.0}

