def main():
    start_time = time.time()
    
    parser = argparse.ArgumentParser(
        description="DLMap v1.0 (Python Core - Ultimate Edition)\nUsage: dlmap [flags] <target_file>",
        formatter_class=argparse.RawTextHelpFormatter
    )
    
    parser.add_argument('target_file', nargs='?', help='Target file path (e.g., /sdcard/app.apk)')
    parser.add_argument('-A', '--all', action='store_true', help='Enables ALL default ultimate static analysis scans.')
    parser.add_argument('-sS', '--secrets', action='store_true', help='Scans for hardcoded keys, tokens, and credentials.')
    
    args = parser.parse_args()
    target_file = args.target_file

    if not target_file:
        parser.print_help()
        sys.exit(0)
    
    # Check if file exists using the robust path
    if not os.path.exists(target_file):
        print("\nError: Target file does not exist.")
        print(f"File Type: cannot open `{target_file}' (No such file or directory)")
        sys.exit(1)

    print(f"Starting DLMap 1.0 (Python Core - Ultimate Edition) at {start_time}")
    print_file_info(target_file)

    # --- EXECUTION LOGIC ---
    
    if args.secrets and not args.all:
        # Execute Secrets Scan ONLY (-sS)
        secrets_results = secrets_module.run_secrets_scan(target_file)
        secrets_module.print_secrets_report(secrets_results)

    elif args.all:
        # Execute Comprehensive Scan (-A)
        
        # 1. Static Analysis 
        entropy_val = run_static_analysis(target_file)
        print_static_report(entropy_val)
        
        # 2. Integrity Check
        check_results = run_integrity_check(target_file)
        print_integrity_report(check_results)

        # 3. Secrets Scan (The final integrated module)
        secrets_results = secrets_module.run_secrets_scan(target_file)
        secrets_module.print_secrets_report(secrets_results) 
        
        # 4. Other Scans
        print_dummy_reports()
        
    else:
        print("Please specify a scan flag (-A, -sS, etc.). Use 'dlmap -h' for help.")

    # --- Completion Report ---
    
    end_time = time.time()
    elapsed_time = end_time - start_time
    print(f"\nDLMap done: 1 IP address (1 host up) scanned in {elapsed_time:.2f} seconds")


if __name__ == '__main__':
    main()

